R&C patch 7065: the menu pointer as an open-end wrench (ENHANCEMENT, built with PAD_CURSOR_WRENCH by
port/rc/CMakeLists.txt). On top of 2111 (KZ3 RSX pass 104), which keeps its arrow for KZ3. After the first
hand play (2026-11-13) the pointer still had the Killzone look; an R&C-styled pointer was wanted, a wrench. Steel fill, R&C accent blue rim
(#1E70B9), hotspot in the jaw mouth. Host test: port/rc/tests/test_rc_cursor_art.c.

diff -ruN a/libs/input/pad_cursor_art.h b/libs/input/pad_cursor_art.h
--- a/libs/input/pad_cursor_art.h	2026-11-13 20:31:08.741588592 -0600
+++ b/libs/input/pad_cursor_art.h	2026-11-13 20:31:08.753350445 -0600
@@ -66,4 +66,55 @@
             px[y * size + x] = A << 24 | R << 16 | G << 8 | B;   /* premultiplied: colour sums already carry alpha */
         }
 }
+/* R&C patch 7065 (ENHANCEMENT): an open-end wrench instead of the arrow, built with PAD_CURSOR_WRENCH (R&C's
+ * port/rc/CMakeLists.txt; an R&C-styled pointer was wanted after the 2026-11-13 hand play). Same renderer: the outline
+ * below, steel fill, the R&C accent blue rim (#1E70B9, docs/in-progress/theme-plan.md), the dark outer edge. The wrench
+ * lies along u (head at u = 0, handle to u = 1), v across it; it is turned 45 degrees so the head points to the top-left
+ * and the jaw's mouth is the hotspot (pad_cursor_wrench_hotspot). */
+#define PAD_CURSOR_WRENCH_FILL 0xD5DBE2u
+#define PAD_CURSOR_WRENCH_RIM  0x1E70B9u
+#define PAD_CURSOR_WRENCH_N 12
+static inline void pad_cursor_wrench_points(float* p, int size, int* hx, int* hy)
+{
+    static const float uv[2 * PAD_CURSOR_WRENCH_N] = {
+        0.00f, -0.17f,  0.22f, -0.17f,  0.31f, -0.065f, 1.00f, -0.065f,   /* jaw top, head, neck, handle edge */
+        1.00f,  0.065f, 0.31f,  0.065f, 0.22f,  0.17f,  0.00f,  0.17f,    /* handle end, back along the other side */
+        0.00f,  0.075f, 0.13f,  0.075f, 0.13f, -0.075f, 0.00f, -0.075f }; /* the jaw's mouth */
+    const float r = 0.70710678f, s = (float)(size - 2) / 0.88f;   /* the outline spans 0.88 of s on both axes */
+    /* u along the diagonal: x = (u - v) * r, y = (u + v) * r; the smallest x and y are -0.17 * r (the jaw tips) */
+    const float o = 0.17f * r;
+    for (int i = 0; i < PAD_CURSOR_WRENCH_N; i++) {
+        const float u = uv[2 * i], v = uv[2 * i + 1];
+        p[2 * i] = 1.0f + ((u - v) * r + o) * s;
+        p[2 * i + 1] = 1.0f + ((u + v) * r + o) * s;
+    }
+    /* hotspot: the middle of the mouth's opening (u = 0.02, v = 0) */
+    *hx = (int)(1.0f + (0.02f * r + o) * s + 0.5f);
+    *hy = *hx;
+}
+static inline void pad_cursor_render_wrench(uint32_t* px, int size, int* hx, int* hy)
+{
+    float p[2 * PAD_CURSOR_WRENCH_N];
+    pad_cursor_wrench_points(p, size, hx, hy);
+    const float rim = size / 30.0f, edge = size / 32.0f;
+    for (int y = 0; y < size; y++)
+        for (int x = 0; x < size; x++) {
+            float r = 0, g = 0, b = 0, a = 0;
+            for (int sy = 0; sy < 4; sy++)
+                for (int sx = 0; sx < 4; sx++) {
+                    float d;
+                    const float fx = x + (sx + 0.5f) / 4, fy = y + (sy + 0.5f) / 4;
+                    const int in = pad_cursor_inside(fx, fy, p, PAD_CURSOR_WRENCH_N, &d);
+                    uint32_t c;
+                    float al = 1;
+                    if (in) c = d < rim ? PAD_CURSOR_WRENCH_RIM : PAD_CURSOR_WRENCH_FILL;
+                    else if (d < edge) { c = PAD_CURSOR_EDGE; al = 0.8f; }
+                    else continue;
+                    r += al * ((c >> 16) & 0xFF); g += al * ((c >> 8) & 0xFF); b += al * (c & 0xFF); a += al;
+                }
+            const uint32_t A = (uint32_t)(a / 16 * 255 + 0.5f), R = (uint32_t)(r / 16 + 0.5f),
+                           G = (uint32_t)(g / 16 + 0.5f), B = (uint32_t)(b / 16 + 0.5f);
+            px[y * size + x] = A << 24 | R << 16 | G << 8 | B;
+        }
+}
 #endif
