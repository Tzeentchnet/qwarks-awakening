--- /dev/null
+++ b/libs/video/rsx_tex_1d.h
@@ -0,0 +1,28 @@
+/* R&C patch 7045: 1D textures (SET_TEXTURE_FORMAT dimension 1) as width x 1 2D textures.
+ *
+ * Live draw decodes a 1D texture through the 2D path as a width x 1 image. The fragment program samples it with the
+ * register's .xy (rsx_fp_decompiler emits the same Sample call for every 2D-path unit), so v is whatever the program
+ * left in the second component. A height-1 texture returns row 0 for any finite v under WRAP, MIRROR, CLAMP and
+ * MIRROR_ONCE, but BORDER blends in the border colour (linear filter: whenever v != 0.5; point: outside [0, 1)). The
+ * RSX has no t coordinate for a 1D texture [src:rpcs3-rsx-graph: RPCS3 creates a real 1D texture], so the V address
+ * mode of a 1D unit is forced to clamp-to-edge, under which every v reads row 0 exactly like a 1D fetch.
+ * Host test: port/rc/tests/run_tex_1d_test.sh (a software sampler compares a 1D fetch against the Wx1 2D fetch). */
+#ifndef RSX_TEX_1D_H
+#define RSX_TEX_1D_H
+
+#include <stdint.h>
+
+/* The texture dimensions the 2D decode path takes: 2, and 1 as a width x 1 image. */
+static inline int ld_tex_2d_path(uint32_t dimension)
+{
+    return dimension == 2u || dimension == 1u;
+}
+
+/* The GCM wrap code (TEXTURE_ADDRESS [11:8], 1 wrap .. 8 mirror-once) used for the V axis of a unit: a 1D unit gets
+ * 3 = clamp to edge whatever the guest wrote there. */
+static inline uint32_t ld_tex_wrap_v(uint32_t dimension, uint32_t gcm_wrap_v)
+{
+    return dimension == 1u ? 3u : (gcm_wrap_v & 0xFu);
+}
+
+#endif
